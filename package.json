{
  "name": "dsh-antigravity",
  "version": "0.0.12",
  "description": "Google Antigravity / Cloud Code Assist model provider for DeepSeek Harness",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-api-remotes",
        "@deepseek-ai/dsh-client-connection",
        "@deepseek-ai/dsh-api-session-controller",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-model-selection",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-settings-plugins",
        "@deepseek-ai/dsh-client-locale"
      ],
      "platform": "web"
    }
  },
  "files": [
    "lib",
    "bin",
    "cordis.patch.yml",
    "README.md",
    "README.zh.md",
    "LICENSE",
    "assets"
  ],
  "bin": {
    "antigravity-login": "bin/antigravity-login.mjs"
  },
  "scripts": {
    "test": "node --test tests/*.test.mjs",
    "check": "node --check lib/index.js && node --check lib/client.js && node --check bin/antigravity-login.mjs",
    "pack:dist": "mkdir -p dist && pnpm pack --pack-destination dist"
  },
  "engines": {
    "node": ">=20"
  },
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "antigravity",
    "google",
    "cloud-code-assist",
    "oauth",
    "llm",
    "adapter"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/LiZhenNet/dsh-antigravity.git"
  },
  "homepage": "https://github.com/LiZhenNet/dsh-antigravity#readme",
  "bugs": {
    "url": "https://github.com/LiZhenNet/dsh-antigravity/issues"
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-home-paths": "^0.1.2-rc.1",
    "@deepseek-ai/dsh-settings": "^0.1.2-rc.1",
    "@deepseek-ai/schemastery": "*",
    "@deepseek-ai/dsh-host-webserver": "^0.1.2-rc.1",
    "@deepseek-ai/dsh-llm": "^0.1.2-rc.1",
    "@deepseek-ai/dsh-timeout": "^0.1.2-rc.1",
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-api-remotes": "^0.1.2-rc.1",
    "@deepseek-ai/dsh-client-connection": "^0.1.2-rc.1",
    "@deepseek-ai/dsh-api-session-controller": "^0.1.2-rc.1",
    "@deepseek-ai/dsh-client-ui-conversation": "^0.1.2-rc.1",
    "@deepseek-ai/dsh-client-ui-model-selection": "^0.1.2-rc.1",
    "@deepseek-ai/dsh-client-ui-settings": "^0.1.2-rc.1",
    "@deepseek-ai/dsh-client-ui-settings-plugins": "^0.1.2-rc.1",
    "@deepseek-ai/dsh-client-locale": "^0.1.2-rc.1",
    "react": "^19.2.0"
  },
  "peerDependenciesMeta": {
    "*": {
      "optional": true
    }
  }
}
